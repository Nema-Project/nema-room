{
  "name": "nema-room",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:check": "node scripts/setup.mjs --check",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "db:up": "docker compose up -d postgres",
    "dev": "concurrently -n hub,web -c blue,green \"npm run dev -w apps/hub\" \"npm run dev -w apps/web\"",
    "up": "node scripts/up.mjs",
    "down": "docker compose down",
    "logs": "docker compose logs -f hub web"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^9.2.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
