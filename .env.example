NEMA_DATABASE_URL=postgres://nema:nema@127.0.0.1:5433/nema
NEMA_DATA_DIR=~/.nema/data
NEMA_HUB_PORT=4400
# Host port for the web container. The container still listens on 3000.
# Compose publishes this port and sets hub CORS from it. `npm run dev` does not read it.
# NEMA_WEB_PORT=3000
# CORS origins for `npm run dev`. Compose sets its own list from NEMA_WEB_PORT.
NEMA_WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Leave unset so compose points the web container at http://127.0.0.1:$NEMA_HUB_PORT.
# Set this only when the browser reaches the hub at a different address.
# NEMA_HUB_URL=http://127.0.0.1:4400
# Read by `npm run dev`. Keep it on the same port as NEMA_HUB_PORT for that process.
# Inside the published image this value is only the baked fallback. The container
# reads NEMA_HUB_URL when it starts.
NEXT_PUBLIC_HUB_URL=http://127.0.0.1:4400
# Hub bind address for `npm run dev` (default 127.0.0.1). The Docker image sets 0.0.0.0 itself.
# NEMA_HUB_HOST=127.0.0.1

# --- Only used by `npm run up` (docker compose) ---
# Host directory bind-mounted as the hub's data dir; the host daemon reads daemon-token from here.
# Keep it equal to the daemon's NEMA_DATA_DIR (default ~/.nema/data). Absolute path.
# NEMA_DATA_HOST_DIR=/home/you/.nema/data
# Linux and macOS: export NEMA_UID="$(id -u)" and NEMA_GID="$(id -g)" before
# `npm run up` or `docker compose up`. Docker Desktop on Windows does not need
# this. Unset values fall back to 1000, which fails for any other Linux or macOS user.
# NEMA_UID=1000
# NEMA_GID=1000

# Hub and web image tag. A supported install writes the full release version here on
# first install and keeps it. Source checkouts leave it unset and build from this tree
# with `npm run up`; it is not a source-version selector.
# The template's `:-latest` only keeps source-only flows (`npm run db:up`) working.
# NEMA_IMAGE_TAG=<x.y.z>
